# syntax=docker/dockerfile:1.7
# SENEX / SENECIO H-011 V3 — reproducible controlled paper-only runtime.
FROM python:3.11-slim@sha256:94c50be2dc994b873b55bc123e95e6dbade08095b3dfd790f51c34de3f08cbb7

ARG SOURCE_DATE_EPOCH=0
ARG SENEX_CODE_SHA=unknown

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    H011_PIPELINE_VERSION=integrity-v3 \
    H011_RESULTS_DIR=/app/polymarket/results

LABEL org.opencontainers.image.revision="${SENEX_CODE_SHA}"

WORKDIR /app

COPY --link polymarket/requirements-h011-v3-runtime.txt /tmp/requirements-h011-v3-runtime.txt
RUN python -m pip install \
      --no-cache-dir \
      --no-compile \
      --no-deps \
      --only-binary=:all: \
      --require-hashes \
      -r /tmp/requirements-h011-v3-runtime.txt \
    && rm -f /tmp/requirements-h011-v3-runtime.txt

# Copy the complete runtime package, including polymarket/discovery_v3.py.
# Repository data and secrets are never baked into the image. File modes are
# normalized for reproducible layers.
COPY --link polymarket/ /app/polymarket/
RUN find /app/polymarket -type d -exec chmod 0755 '{}' + \
    && find /app/polymarket -type f -exec chmod 0644 '{}' + \
    && find /app/polymarket -type d -name __pycache__ -prune -exec rm -rf '{}' + \
    && mkdir -p \
      /app/polymarket/results/v3/state \
      /app/polymarket/results/h011_v3/raw_chain_v1

WORKDIR /app/polymarket
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/livez', timeout=3).read()"

CMD ["python3", "/app/polymarket/h011_v3_runtime.py"]
